{
  "name": "@lucidjs/icons",
  "private": false,
  "version": "0.1.0",
  "description": "Simply beautiful icon library, all available as React components. Make them your own.",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "import": "./dist/native/index.mjs",
        "require": "./dist/native/index.js"
      },
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.mjs",
      "require": "./dist/web/index.js"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react-native-svg": "15.15.5",
    "tsup": "8.5.1",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "react": "19",
    "react-native-svg": "15"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  }
}