{
  "name": "@lucidjs/web",
  "private": false,
  "version": "0.1.0",
  "description": "Lucid UI Kit for Web",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./assets/styles/fonts.css": "./dist/assets/styles/fonts.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "storybook dev --port 3001",
    "build": "tsc && vite build",
    "build:storybook": "storybook build",
    "lint": "eslint . --ext ts,tsx",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lucidjs/cli": "0.1.0",
    "@lucidjs/core": "0.1.0",
    "@lucidjs/icons": "0.1.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "17.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
